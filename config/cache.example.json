{
  "enabled": true,
  "key_prefix": "tool_cache",
  "backend": "sqlite",
  "sqlite": {
    "path": ".cache/tool_cache.db",
    "default_ttl_seconds": null
  },
  "mysql": {
    "host": "localhost",
    "port": 3306,
    "user": "tool_user",
    "password": "CHANGE_ME",
    "database": "tool_cache",
    "table_name": "tool_cache_entries",
    "charset": "utf8mb4",
    "autocommit": true,
    "use_connection_pool": false,
    "pool_size": 5,
    "max_overflow": 5,
    "pool_timeout": 30,
    "pool_recycle": 3600,
    "default_ttl_seconds": null
  }
}
