# Sandbox endpoints (comma-separated) used by tools/python_tool
SANDBOX_FUSION_ENDPOINTS=

# Legacy environment variable supported for compatibility (single endpoint or comma-separated)
SANDBOX_FUSION_ENDPOINT=

# Serper API key used by search-related clients
SERPER_API_KEY=

# Jina API key (optional) for enhanced content extraction
JINA_API_KEY=

# OpenAI configuration for examples/registry_openai_demo.py
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Toggle registry-level caching (true/false)
CACHE_ENABLED=false

# Path to cache configuration JSON (only read when CACHE_ENABLED is true)
CACHE_CONFIG_PATH=config/cache.json

# Override cache backend (optional). Values: sqlite, mysql. Defaults to value in cache config.
CACHE_BACKEND=

# Summarizer configuration: enable flag plus optional JSON config path (see config/summary.example.json)
SUMMARIZER_ENABLED=false
SUMMARIZER_CONFIG_PATH=config/summary.json

# MCP server config path (see config/mcp.example.json)
MCP_CONFIG_PATH=config/mcp.json

# Responses API demo MCP connection (optional)
RESPONSES_MCP_URL=http://127.0.0.1:8000/mcp
RESPONSES_MCP_TOKEN=
